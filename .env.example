# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
# Реальные значения (токены, пароли) НИКОГДА не коммитятся — только этот файл.

# Публичный адрес сайта (canonical, hreflang, OG-изображения).
# NEXT_PUBLIC_* вшиваются при сборке: для production — GitHub → Environments → production → Variables
# (docs/deploy.md). Серверные переменные production — /etc/uly-dala/production.env (deploy/env/).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# preview — сборка для превью PR (закрыта от поиска). Ставит .github/workflows/preview.yml.
NEXT_PUBLIC_SITE_ENV=
# Телефон для звонка: только цифры с кодом страны. TODO(client-data).
NEXT_PUBLIC_PHONE=

# WhatsApp для плавающей кнопки на мобильных: только цифры с кодом страны. Пусто — кнопки нет.
# TODO(client-data): подтверждённый номер.
NEXT_PUBLIC_WHATSAPP_PHONE=

# --- Заявки (CLAUDE.md, разделы 9 и 14) ---
# Хранилище заявок: SQLite на диске сервера в РК (docs/deploy.md). В production путь —
# /var/lib/uly-dala/leads.sqlite. TODO(legal): юрист подтверждает площадку.
LEADS_STORAGE=sqlite
LEADS_SQLITE_PATH=.data/leads.sqlite

# Защита от спама: не больше RATE_LIMIT_MAX заявок с одного IP за окно (мс).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
# Соль для хэша IP (IP не хранится в открытом виде). В production — длинная случайная строка.
RATE_LIMIT_SALT=

# Уведомления менеджерам: live — отправлять, mock — только записывать в базу.
# По умолчанию: mock в разработке, live в production.
NOTIFY_TRANSPORT=
# Telegram-бот менеджеров
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email: SMTP-адрес вида smtps://user:password@smtp.example.com:465
SMTP_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Алерт, если уведомления не доставлены за 3 попытки: POST JSON на этот адрес (без персональных данных).
ALERT_WEBHOOK_URL=

# --- Мониторинг ошибок (CLAUDE.md, раздел 14; docs/security.md) ---
# DSN проекта Sentry. Пусто — ошибки только в журнале сервера (строки JSON).
# Ключ только на сервере: браузер шлёт ошибки на /api/m, сервер пересылает в Sentry.
SENTRY_DSN=
