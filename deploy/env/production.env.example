# /etc/uly-dala/production.env — переменные СЕРВЕРА production (права 600, владелец uly-dala).
# Публичные NEXT_PUBLIC_* вшиваются при сборке — они в GitHub → Settings → Environments →
# production → Variables (docs/deploy.md), не здесь.
# Полный список и пояснения — .env.example в корне репозитория.

# База заявок — на сервере в РК (решение заказчика, шаг 20; закон РК о персональных данных).
LEADS_STORAGE=sqlite
LEADS_SQLITE_PATH=/var/lib/uly-dala/leads.sqlite

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
# Длинная случайная строка: openssl rand -hex 32
RATE_LIMIT_SALT=

NOTIFY_TRANSPORT=live
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
ALERT_WEBHOOK_URL=

SENTRY_DSN=
