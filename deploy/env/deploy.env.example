# /etc/uly-dala/deploy.env — настройки Caddy и скриптов выкладки.
# Домен сайта (A-записи домена и www — на IP сервера).
SITE_DOMAIN=example.kz
# Почта для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=
# Превью: pr-<N>.<PREVIEW_DOMAIN>; DNS: A-запись *.preview.example.kz → IP сервера.
PREVIEW_DOMAIN=preview.example.kz
PREVIEW_USER=uly
# Хеш пароля превью: caddy hash-password (сам пароль — команде, не в репозиторий).
PREVIEW_PASSWORD_HASH=
